# Liner (platform.liner.com) API key. Both naming styles are accepted.
LINER_API_KEY=sk_live_xxx

# Anthropic Messages API — for the Socratic loop and summarization.
# Either of these works; ANTHROPIC_AUTH_TOKEN is honored as a fallback.
ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_AUTH_TOKEN=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional overrides
# LINER_BASE_URL=https://platform.liner.com
# RESEARCH_OUTPUT_DIR=/absolute/path/to/output
# MAX_WONDER_ROUNDS=5
# MAX_REFINE_ROUNDS=3